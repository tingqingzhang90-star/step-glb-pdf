# ===== 结果存储配置 =====
# 本地 output/ 仍是工作存储;OSS 作为可配置的结果镜像/外链。
# 不配置或保持 local 时,行为与改造前完全一致(纯本地)。

# 存储后端:local(默认) | oss
STORAGE_BACKEND=local

# ---- OSS(S3 兼容协议:阿里云 OSS / 腾讯云 COS / MinIO / AWS S3 通用)----
# 接入域名(必须是对应厂商的 S3 兼容端点)
#   阿里云 OSS: https://oss-cn-hangzhou.aliyuncs.com
#   腾讯云 COS: https://cos.ap-guangzhou.myqcloud.com
#   MinIO:     http://127.0.0.1:9000
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_BUCKET=your-bucket
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 对象存储中的 key 前缀(可空);最终 key = PREFIX/<型号>/<文件>
OSS_PREFIX=step-output
# 留空 = 用临时签名 URL(默认 1h,见下),适合私有桶;
# 填了 = 用公开基址(CDN),如 https://cdn.example.com/step-output,适合已设公共读
OSS_PUBLIC_BASE=
# 签名 URL 有效期(秒)
OSS_PRESIGN_EXPIRE=3600

# ===== OCC 任务池并行度 =====
# 投影任务池 worker 数;默认 min(4, CPU 核数)。
# 上限参考:单个跑过任务的 worker 常驻 290-480MB,按可用内存定。
BUILD_POOL_WORKERS=4
