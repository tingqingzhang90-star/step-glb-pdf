# 本地环境配置模板(入库)
# 用法:复制为 .env 后按需修改,.env 不入库
# 已存在的系统环境变量优先:.env 不会覆盖命令行/系统里已设的值

# OCC 任务池并行 worker 数,默认 min(4, CPU核数)
# 每个 worker 是独立 python 进程:导入 OCC 约 84MB,加载 STEP 后约 214MB,
# 投影峰值 400~600MB。按 内存GB / 0.5GB 估可用上限,超过 CPU 逻辑核数无收益。
BUILD_POOL_WORKERS=4

# 调试开关:1 = 任务改在主进程线程内执行(便于 IDE 下断点与单测打桩)
# 代价是失去进程隔离、不保证 OCC 线程安全,禁止生产开启
# OCC_POOL_INLINE=0

# 主链路出图算法:algo = 精确 HLRBRep_Algo(默认, 保留原生圆/弧语义);
# poly = HLRBRep_PolyAlgo 离散 + 圆弧拟合恢复 circle/arc 语义, 速度更快
DRAWING_ALGO=algo

# poly 模式三角化精度(mm),越小越精确越慢
DRAWING_POLY_DEFLECTION=2.0
# poly 模式是否对离散段做圆弧拟合恢复圆/弧
DRAWING_POLY_DO_FIT=true
