{
  "name": "250系列液压缸工程图模板",
  "template_id": "250-E-H2K1",
  "version": 2,
  "sheet": {
    "size": "A3",
    "width": 420,
    "height": 297
  },
  "anchor_profile": "resolved-per-model",
  "views": [
    {
      "id": "left",
      "type": "left",
      "x": 45,
      "y": 30,
      "scale": "auto",
      "target_width": 340,
      "target_height": 70
    },
    {
      "id": "front",
      "type": "front",
      "x": 60,
      "y": 140,
      "scale": "auto",
      "target_width": 90,
      "target_height": 80
    }
  ],
  "dimensions": [
    {
      "id": "dim_total_height",
      "type": "linear",
      "view": "front",
      "orientation": "vertical",
      "edge1_ref": {"method": "bbox_y_min"},
      "edge2_ref": {"method": "bbox_y_max"},
      "offset": 30,
      "label": "总高"
    },
    {
      "id": "dim_total_width",
      "type": "linear",
      "view": "front",
      "orientation": "horizontal",
      "edge1_ref": {"method": "bbox_x_min"},
      "edge2_ref": {"method": "bbox_x_max"},
      "offset": 30,
      "label": "总宽"
    },
    {
      "id": "dim_bore",
      "type": "diameter",
      "view": "left",
      "from_anchor": "cylinder.axis",
      "offset": 25,
      "label": "缸径"
    },
    {
      "id": "dim_cyl_length",
      "type": "linear",
      "view": "left",
      "orientation": "horizontal",
      "from_anchor": "cylinder.front_end",
      "to_anchor": "cylinder.back_end",
      "offset": 45,
      "label": "缸长D1"
    },
    {
      "id": "dim_motor_length",
      "type": "linear_text",
      "view": "left",
      "orientation": "horizontal",
      "from_anchor": "motor.axis_min_face",
      "to_anchor": "motor.axis_max_face",
      "text": "减速机尺寸",
      "offset": 62,
      "condition": "has_motor",
      "label": ""
    },
    {
      "id": "motor_text",
      "type": "text",
      "view": "left",
      "condition": "has_motor",
      "text": "电机: {{motor}}",
      "position": {"x": 250, "y": 125}
    }
  ],
  "title_block": {
    "fields": [
      {"name": "图样名称", "value": "{{series}}液压缸", "x": 318, "y": 262},
      {"name": "型号", "value": "{{model_code}}", "x": 318, "y": 270},
      {"name": "比例", "value": "1:{{scale}}", "x": 318, "y": 278},
      {"name": "行程", "value": "{{stroke}}mm", "x": 360, "y": 262},
      {"name": "缸长D1", "value": "{{d1}}mm", "x": 360, "y": 270},
      {"name": "日期", "value": "{{date}}", "x": 360, "y": 278}
    ]
  }
}
