{
  "_comment": "前后端共用样式配置。前端用 px(屏幕像素,SVG non-scaling-stroke),后端按 96dpi 折算成 mm。改一处同步两端。",

  "edge": {
    "visible": { "stroke_px": 1.0, "color": "#303133" },
    "hidden":  { "stroke_px": 0.8, "color": "#999999" }
  },

  "dim": {
    "line":  { "stroke_px": 1.0, "color": "#303133" },
    "ext":   { "stroke_px": 0.8, "color": "#606266" },
    "text":  { "font_px": 18,    "color": "#303133" },
    "arrow": { "len_px": 3,   "half_px": 0.3 }
  },

  "center_mark": {
    "stroke_px": 0.8,
    "color": "#303133"
  },

  "frame": {
    "stroke_px": 1.0,
    "color": "#999999"
  },

  "title_block": {
    "stroke_px": 1.0,
    "color": "#555555"
  },

  "table": {
    "_comment": "表格绘制在 SVG viewBox 内,长度单位即 mm,不经 _px_to_mm_at_96dpi 折算;font_px 例外,沿用 96dpi 折算(与 dim.text 一致)",
    "text":   { "font_px": 13,    "color": "#303133" },
    "border": { "stroke_mm": 0.3, "color": "#303133" },
    "col_width_mm": 30,
    "row_height_mm": 8
  },

  "_px_to_mm_at_96dpi": 0.2645833
}
